# VX1000 uses an FTDI FT232R. The default 16 ms latency timer batches 100 Hz
# IMU frames and adds timestamp jitter. Install this on the vehicle host:
#
#   sudo cp deploy/udev/99-smartcar-ftdi.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger --subsystem-match=usb-serial
#
ACTION=="add", SUBSYSTEM=="usb-serial", DRIVER=="ftdi_sio", ATTR{latency_timer}="1"
