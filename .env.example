# Copy this file to .env (never commit .env).
COMPOSE_PROJECT_NAME=smartcar
IMAGE=smartcar-ros2
IMAGE_TAG=dev
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Development machine
DEV_INTERFACE=enp5s0
DEV_IP=192.168.100.123

# Vehicle IPC
VEHICLE=yunle@192.168.100.10
VEHICLE_DIR=/opt/smartcar
VEHICLE_INTERFACE=enp1s0
VEHICLE_IP=192.168.100.10
# Used by deploy/compose.vehicle.yaml; the release bundle sets ./config.
SMARTCAR_CONFIG_HOST_DIR=./config

# VX1000 serial device. Prefer the stable by-id path on the vehicle.
VX1000_DEVICE=/dev/ttyUSB0
# VX1000_DEVICE=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_B0029FI4-if00-port0

# Bags (dev machine)
BAGS_DIR=./bags
BAG=latest
